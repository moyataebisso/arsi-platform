{
  "name": "arsi-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:dashboard": "turbo dev --filter=dashboard",
    "dev:starter": "turbo dev --filter=starter-app",
    "lint": "turbo lint",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=18"
  }
}
