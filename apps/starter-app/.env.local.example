# Supabase -- CLIENT OWNS THIS (help them create free account)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend -- your account, client's domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@clientdomain.com

# Stripe -- CLIENT OWNS THIS (help them create account)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 -- YOUR account (for backups)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=arsi-backups
CLIENT_SLUG=client-name

# Cron
CRON_SECRET=

# Discord -- YOUR account (backup notifications)
DISCORD_WEBHOOK_DAILY_REPORTS=
